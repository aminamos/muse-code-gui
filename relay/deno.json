{
  "tasks": {
    "start": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env src/server.ts",
    "start-remote": "deno task start --allow-remote",
    "mcp-stdio": "deno run --allow-run --allow-read --allow-write --allow-env --allow-net src/mcp-stdio.ts",
    "check": "deno check src/server.ts src/mcp-stdio.ts tests/*_test.ts",
    "test": "deno test --allow-run --allow-read --allow-write --allow-env --allow-net tests/",
    "test-unit": "deno test --allow-run --allow-read --allow-write --allow-env tests/parse_test.ts tests/ingest_test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  }
}
